# Sahistra Backend Environment Configuration (Template)

# Authentication Token for WebSocket and API
SAHISTRA_AUTH_TOKEN=sahistra_secret_123

# LLM Provider Configuration
# Choose: "groq", "gemini", or "mock"
LLM_PROVIDER=groq
LLM_MODEL_NAME=llama-3.3-70b-versatile

# Groq API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Optional alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Generation Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=30.0

# In-Memory Context (Max complete User + Assistant turn pairs)
MAX_CONTEXT_TURNS=10

# Assistant Persona
SYSTEM_INSTRUCTION=You are Sahistra, a fast, intelligent, and concise personal AI assistant.
